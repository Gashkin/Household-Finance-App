# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Generated workbook analysis and loader outputs
AnalysisScripts/output/

# Generated backend runtime and build outputs
backend/data/*.db
backend/data/*.lock.db
backend/target/

# Generated frontend build output
frontend/dist/
frontend/node_modules/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Never commit household runtime data or personal source workbooks
/data/
/**/data/*.mv.db
/**/data/*.trace.db
**/*.xlsx
**/*.xlsm
**/*.xls
**/*.ods
/backend/sql/*.sql
/AnalysisScripts/*.csv
/Docs/*.csv
**/__pycache__/
*.py[cod]
.env
.env.*
!.env.example

# Synthetic browser verification outputs
frontend/test-results/
frontend/playwright-report/

# Operator verification receipts (CI retains these separately)
delivery-receipt.json

# Recovery archives must never enter Git
*.hfb

# Local release packages and provider state
/release/
/.tools/
*.pem
*.key
**/bank-connection.bin
**/bank-connection.bin.initialized

# Local environment and private runtime material (GBD-30)
/.venv/
/.worktrees/
/backups/
/secrets/
/config.xml
*.db
*.p12
*.pfx
*.jks
